file(SHA1 "${DIR}/index.js" js)
file(SHA1 "${DIR}/index.wasm" wasm)
file(SHA1 "${DIR}/index.data" data)
string(SHA1 stamp "${js}${wasm}${data}")
string(SUBSTRING "${stamp}" 0 12 stamp)
file(READ "${DIR}/index.html" html)
string(REPLACE "__BUILD__" "${stamp}" html "${html}")
string(REPLACE "src=index.js>" "src=index.js?v=${stamp}>" html "${html}")
string(REPLACE "src=\"index.js\"" "src=\"index.js?v=${stamp}\"" html "${html}")
file(WRITE "${DIR}/index.html" "${html}")
message(STATUS "Stamped index.html with build ${stamp}")
