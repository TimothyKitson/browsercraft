# Anchored to the repository root on purpose. An unanchored "world/"
# matches any directory of that name at any depth, and git turns on
# core.ignorecase on Windows, so it quietly swallowed src/World/ -- the
# whole terrain module -- and the repository would not build from a
# clean clone. Keep the leading slash on anything with a generic name.
/build/
/build-web/
/out/
/world/
/.cache/
/browsercraft-netlify.zip
compile_commands.json
*.log
*.user

# Texture packs and skins are runtime assets, not disposable build output.
# Keep them visible to Git so a clean clone/browser deployment can include
# the art the game is configured to load. Only commit files you own or have
# permission to redistribute; a credit file alone is not permission.

# Optional external audio packs are different: the engine synthesizes
# fallback sounds and public web builds include audio only with --sound-files.
/assets/sounds/

# Screenshots are made by the game and belong on the machine that made
# them, not in the repository.
/screenshots/
