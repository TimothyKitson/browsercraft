  OBJECT_DIR = _deps/glm-build/glm/CMakeFiles/glm.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = _deps/glm-build/glm/libglm.a
  TARGET_PDB = glm.a.dbg


