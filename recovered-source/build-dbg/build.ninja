build _deps/glm-build/glm/CMakeFiles/glm.dir/detail/glm.cpp.o: CXX_COMPILER__glm_unscanned_Release /home/user/browsercraft/recovered-source/build-dbg/_deps/glm-src/glm/detail/glm.cpp || cmake_object_order_depends_target_glm
  DEP_FILE = _deps/glm-build/glm/CMakeFiles/glm.dir/detail/glm.cpp.o.d
  FLAGS = -O3 -DNDEBUG -std=c++17 -Wno-c++98-compat -Wno-c++98-compat-pedantic
  INCLUDES = -I/home/user/browsercraft/recovered-source/build-dbg/_deps/glm-src
  OBJECT_DIR = _deps/glm-build/glm/CMakeFiles/glm.dir
  OBJECT_FILE_DIR = _deps/glm-build/glm/CMakeFiles/glm.dir/detail


