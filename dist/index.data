#version 330 core

in vec2 vUV;

uniform sampler2D uTexture;
uniform vec4 uColor;

out vec4 FragColor;

void main()
{
    vec4 color = texture(uTexture, vUV);
    if (color.a == 0.0) discard;
    FragColor = color * uColor;
}
#version 330 core

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aUV;

uniform mat4 uView;
uniform mat4 uProjection;

out vec2 vUV;

void main()
{
    vUV = aUV;
    gl_Position = uProjection * uView * vec4(aPos, 1.0);
}
#version 330 core

in vec2 vUV;
in vec3 vTint;
in float vTintSelective;
in float vShade;
in float vSkyLight;
in float vBlockLight;
in float vViewDistance;
in vec3 vWorldPos;
in vec3 vNormal;
in vec3 vTangent;
in vec3 vBitangent;
flat in int vIsCross;
flat in int vDeriveBasis;

uniform sampler2D uAtlas;
uniform sampler2D uNormalAtlas;   // LabPBR _n: normal.xy, ambient occlusion, height
uniform sampler2D uSpecularAtlas; // LabPBR _s: smoothness, F0, porosity, emission

uniform float uDaylight;     // 0 at midnight, 1 at noon
uniform vec3 uFogColor;
uniform float uFogStart;
uniform float uFogEnd;
uniform int uUnderwater;
uniform vec3 uSunDirection;
uniform vec3 uCameraPos;
uniform int uPbrEnabled;
// Light floor for a world with no sun. The Nether is lit well above
// pitch black even where nothing is burning.
uniform float uAmbient;

out vec4 FragColor;

// The atlas is a grid of tiles, so a UV may only be moved within the
// tile it landed in. Step outside and the stone picks up the edge of
// whatever was painted next to it.
uniform float uAtlasTiles;
uniform int uGlint;
uniform sampler2D uGlintTexture;
uniform vec2 uGlintShift;
uniform float uGlintScale;

// How deep the relief reads, as a fraction of a block. Small: this is
// the one knob that turns believable stonework into melted wax.
const float PARALLAX_DEPTH = 0.075;

// Walks the view ray into the surface until it meets the height map,
// and gives back the UV of the point it actually hit. This is what
// makes a wall look cut rather than painted: the texels move against
// each other as you walk past, which no amount of shading can fake.
vec2 parallaxUV(vec2 uv, vec3 viewTangent)
{
    vec2 tile = floor(uv * uAtlasTiles);
    vec2 within = uv * uAtlasTiles - tile;

    // More steps edge-on, where the ray crosses more of the height
    // field and a coarse march shows up as banding.
    float layers = mix(28.0, 10.0, clamp(abs(viewTangent.z), 0.0, 1.0));
    float layerDepth = 1.0 / layers;

    // The ray's travel across the surface per layer of depth. Clamped
    // so a ray that is almost edge-on does not shoot off sideways.
    vec2 step = (viewTangent.xy / max(abs(viewTangent.z), 0.35))
                * PARALLAX_DEPTH / layers;

    float depth = 0.0;
    vec2 at = within;
    float surface = 1.0 - textureLod(uNormalAtlas, (tile + fract(at)) / uAtlasTiles, 0.0).a;

    for (int i = 0; i < 32; ++i)
    {
        if (depth >= surface) break;
        at -= step;
        surface = 1.0 - textureLod(uNormalAtlas, (tile + fract(at)) / uAtlasTiles, 0.0).a;
        depth += layerDepth;
    }

    // One step back, and split the difference between the last sample
    // above the surface and the first below it. Without this the march
    // shows as steps across a slope.
    vec2 before = at + step;
    float after = surface - depth;
    float priorSurface = 1.0 - textureLod(uNormalAtlas,
                                          (tile + fract(before)) / uAtlasTiles, 0.0).a;
    float prior = priorSurface - depth + layerDepth;

    float blend = after / max(after - prior, 0.0001);
    at = mix(at, before, clamp(blend, 0.0, 1.0));

    return (tile + fract(at)) / uAtlasTiles;
}

void main()
{
    vec2 uv = vUV;

    // The frame this fragment is shaded in. Usually the one the vertex
    // stage looked up, but a surface that has been turned -- the block
    // in your hand -- has to have it worked out from the triangle, or
    // the relief would be lit as though the block were still sitting
    // in the ground where its texture came from.
    vec3 faceNormal = vNormal;
    vec3 faceTangent = vTangent;
    vec3 faceBitangent = vBitangent;

    if (vDeriveBasis == 1)
    {
        vec3 alongX = dFdx(vWorldPos);
        vec3 alongY = dFdy(vWorldPos);
        vec2 uvX = dFdx(vUV);
        vec2 uvY = dFdy(vUV);

        faceNormal = normalize(cross(alongX, alongY));

        // Winding decides which way that cross product points, and the
        // held item is wound backwards on purpose. Turn it to face the
        // eye rather than trusting it.
        if (dot(faceNormal, uCameraPos - vWorldPos) < 0.0) faceNormal = -faceNormal;

        vec3 acrossY = cross(alongY, faceNormal);
        vec3 acrossX = cross(faceNormal, alongX);
        faceTangent = acrossY * uvX.x + acrossX * uvY.x;
        faceBitangent = acrossY * uvX.y + acrossX * uvY.y;

        float longest = inversesqrt(max(dot(faceTangent, faceTangent),
                                        dot(faceBitangent, faceBitangent)));
        faceTangent *= longest;
        faceBitangent *= longest;
    }

    // The relief has to be found before anything is sampled, since
    // every map is then read at the point the eye actually sees.
    if (uPbrEnabled == 1 && vIsCross == 0)
    {
        vec3 toEye = normalize(uCameraPos - vWorldPos);
        vec3 viewTangent = vec3(dot(toEye, faceTangent),
                                dot(toEye, faceBitangent),
                                dot(toEye, faceNormal));
        uv = parallaxUV(vUV, viewTangent);
    }

    vec4 texel = texture(uAtlas, uv);
    if (texel.a < 0.1) discard; // leaf gaps, plant cut-outs
    vec3 biomeTint = vTintSelective > 0.5 ? mix(vec3(1.0), vTint, step(texel.r + 0.02, texel.g)) : vTint;
    texel.rgb *= biomeTint;
    if (uGlint == 1)
    {
        mat2 turn = mat2(0.9848, 0.1736, -0.1736, 0.9848);
        vec2 sweep = turn * (vUV * uGlintScale) + uGlintShift;
        FragColor = vec4(texture(uGlintTexture, sweep).rgb * 0.75, 1.0);
        return;
    }

    // Baked voxel lighting: sunlight dims at night, torch light never does.
    float sky = vSkyLight * uDaylight;
    float level = max(sky, vBlockLight);
    float brightness = mix(uAmbient, 1.0, level);

    vec3 albedo = texel.rgb;
    vec3 color = albedo * brightness * vShade;

    if (uPbrEnabled == 1 && vIsCross == 0)
    {
        vec4 normalSample = texture(uNormalAtlas, uv);
        vec4 specularSample = texture(uSpecularAtlas, uv);

        // LabPBR stores only X and Y; Z is reconstructed as a unit vector.
        vec2 tangentXY = normalSample.rg * 2.0 - 1.0;
        float tangentZ = sqrt(clamp(1.0 - dot(tangentXY, tangentXY), 0.0, 1.0));
        vec3 normal = normalize(faceTangent * tangentXY.x +
                                faceBitangent * tangentXY.y +
                                faceNormal * tangentZ);

        float materialAO = normalSample.b;
        float height = normalSample.a;
        float smoothness = specularSample.r;
        float reflectance = specularSample.g;
        // Alpha 255 means "not emissive"; 0-254 maps to 0..1.
        float emission = specularSample.a > 0.996 ? 0.0 : specularSample.a * (255.0 / 254.0);

        // Only surfaces the sky actually reaches get direct sun.
        float sunReach = vSkyLight * uDaylight;
        float incidence = max(dot(normal, uSunDirection), 0.0);
        float direct = incidence * sunReach;

        // Shape, measured as the texel's departure from the flat face so
        // the baked per-face shading is not counted twice. The halved
        // form this used -- dot * 0.5 + 0.5 on both sides -- threw away
        // half of an already small number, and a wall with a perfectly
        // good normal map came out looking painted on. The difference
        // of the two dots is taken whole, which is the actual Lambert
        // term the bump earns over the flat face.
        float bumpLit = dot(normal, uSunDirection);
        float flatLit = dot(faceNormal, uSunDirection);
        // Gained down from 1.45. Taking the Lambert difference whole
        // was the fix for a wall that looked painted on, but on a
        // texture whose normals run to half a unit -- cobblestone, and
        // the stone bricks -- it swung neighbouring texels through
        // three times the brightness and the stone came out as a
        // jumble rather than as stonework. Readable relief, not noise.
        float shape = (bumpLit - flatLit) * mix(0.42, 0.72, sunReach);

        // The pack's height map darkens the crevices. This one owes
        // nothing to the sun, so it survives shade, night and caves.
        // Read across the whole range rather than only the top half:
        // the atlas has already stretched each tile to fill it.
        // Narrowed to match: with each tile's height now stretched to
        // the full range, the old span darkened a crevice by two fifths
        // on its own, and that landed on top of the shape term.
        float cavity = mix(0.80, 1.04, height);

        // The clamp is the backstop rather than the shape of the
        // effect: anything reaching it is a texel the normal map has
        // turned nearly away from the sun, and a five-fold swing
        // between one cobble and the next is not what that should look
        // like.
        float relief = mix(0.90, 1.12, direct) * clamp(1.0 + shape, 0.66, 1.34);
        color = albedo * brightness * vShade * relief * cavity * mix(1.0, materialAO, 0.75);

        // Blinn-Phong highlight, sharpened by the pack's smoothness map.
        vec3 viewDir = normalize(uCameraPos - vWorldPos);
        vec3 halfway = normalize(viewDir + uSunDirection);
        float specularPower = exp2(1.0 + smoothness * 9.0);
        float highlight = pow(max(dot(normal, halfway), 0.0), specularPower);
        color += vec3(1.0, 0.97, 0.90) * highlight * smoothness * (0.04 + reflectance) * direct * 2.0;

        color += albedo * emission * 1.6;
    }

    // A world with no sun still has to show its surfaces. Flooring the
    // light level alone was not enough: per-face shading and the PBR
    // relief term multiply on top of it and drag everything back to
    // black, so the floor is applied to the finished colour.
    color = max(color, albedo * uAmbient);

    float fogAmount = clamp((vViewDistance - uFogStart) / max(uFogEnd - uFogStart, 0.001), 0.0, 1.0);
    vec3 fogColor = uFogColor;

    if (uUnderwater == 1)
    {
        color = mix(color, vec3(0.10, 0.30, 0.55), 0.45);
        fogColor = vec3(0.07, 0.21, 0.42);
        fogAmount = clamp(vViewDistance / 24.0, 0.0, 1.0);
    }

    color = mix(color, fogColor, fogAmount);
    FragColor = vec4(color, texel.a);
}
#version 330 core

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aUV;
layout (location = 2) in float aShade;      // face direction * ambient occlusion
layout (location = 3) in float aSkyLight;   // 0..1
layout (location = 4) in float aBlockLight; // 0..1
layout (location = 5) in float aFace;       // face + 8 * block id; faces 0-5, 6 = plant, 7 = turned
layout (location = 6) in float aTint;

uniform mat4 uView;
uniform mat4 uProjection;
uniform vec3 uChunkOffset;

out vec2 vUV;
out vec3 vTint;
out float vTintSelective;
out float vShade;
out float vSkyLight;
out float vBlockLight;
out float vViewDistance;
out vec3 vWorldPos;
out vec3 vNormal;
out vec3 vTangent;
out vec3 vBitangent;
flat out int vIsCross;
// 1 when the frame has to come from the triangle rather than from the
// table above: anything whose faces are not axis-aligned in the world,
// which is what the block in your hand is once the arm has turned it.
flat out int vDeriveBasis;

// Tangent frames per cube face, matching the UV layout the mesher emits:
// tangent follows +U, bitangent follows "up" in the texture image.
const vec3 FACE_NORMAL[6] = vec3[6](
    vec3( 1.0,  0.0,  0.0), vec3(-1.0,  0.0,  0.0),
    vec3( 0.0,  1.0,  0.0), vec3( 0.0, -1.0,  0.0),
    vec3( 0.0,  0.0,  1.0), vec3( 0.0,  0.0, -1.0)
);
const vec3 FACE_TANGENT[6] = vec3[6](
    vec3( 0.0,  0.0,  1.0), vec3( 0.0,  0.0,  1.0),
    vec3( 1.0,  0.0,  0.0), vec3( 1.0,  0.0,  0.0),
    vec3( 1.0,  0.0,  0.0), vec3( 1.0,  0.0,  0.0)
);
const vec3 FACE_BITANGENT[6] = vec3[6](
    vec3( 0.0,  1.0,  0.0), vec3( 0.0,  1.0,  0.0),
    vec3( 0.0,  0.0, -1.0), vec3( 0.0,  0.0, -1.0),
    vec3( 0.0,  1.0,  0.0), vec3( 0.0,  1.0,  0.0)
);

void main()
{
    vec3 worldPos = aPos + uChunkOffset;
    vec4 viewPos = uView * vec4(worldPos, 1.0);

    gl_Position = uProjection * viewPos;

    vUV = aUV;
    uint packedTint = uint(max(aTint, 0.0) + 0.5);
    vTint = vec3(float((packedTint >> 14u) & 127u), float((packedTint >> 7u) & 127u), float(packedTint & 127u)) / 64.0;
    vTintSelective = float((packedTint >> 21u) & 1u);
    vShade = aShade;
    vSkyLight = aSkyLight;
    vBlockLight = aBlockLight;
    vViewDistance = length(viewPos.xyz);
    vWorldPos = worldPos;

    int face = int(aFace + 0.5) & 7;
    if (face == 7)
    {
        // Mapped, but turned: the fragment stage works the frame out
        // from the triangle it is shading.
        vIsCross = 0;
        vDeriveBasis = 1;
        vNormal = vec3(0.0, 1.0, 0.0);
        vTangent = vec3(1.0, 0.0, 0.0);
        vBitangent = vec3(0.0, 0.0, -1.0);
    }
    else if (face >= 6)
    {
        // Plants are billboards: just face upwards and skip normal mapping.
        vIsCross = 1;
        vDeriveBasis = 0;
        vNormal = vec3(0.0, 1.0, 0.0);
        vTangent = vec3(1.0, 0.0, 0.0);
        vBitangent = vec3(0.0, 0.0, -1.0);
    }
    else
    {
        vIsCross = 0;
        vDeriveBasis = 0;
        vNormal = FACE_NORMAL[face];
        vTangent = FACE_TANGENT[face];
        vBitangent = FACE_BITANGENT[face];
    }
}
#version 330 core
#include "common.glsl"

in vec2 vUv;
uniform sampler2D uSource;
uniform vec2 uTexel;
uniform int uFirst;

out vec4 FragColor;

vec3 tap(vec2 offset)
{
    vec3 c = texture(uSource, vUv + offset * uTexel).rgb;
    if (uFirst == 1)
    {
        float l = luma(c);
        c *= (smoothstep(0.85, 2.6, l) + 0.04) / (1.0 + l * 0.25);
    }
    return c;
}

void main()
{
    vec3 centre = tap(vec2(0.0));
    vec3 ring = tap(vec2(-1.0, -1.0)) + tap(vec2(1.0, -1.0)) + tap(vec2(-1.0, 1.0)) + tap(vec2(1.0, 1.0));
    vec3 outer = tap(vec2(-2.0, 0.0)) + tap(vec2(2.0, 0.0)) + tap(vec2(0.0, -2.0)) + tap(vec2(0.0, 2.0));
    FragColor = vec4(centre * 0.25 + ring * 0.125 + outer * 0.0625, 1.0);
}
#version 330 core

in vec2 vUv;
uniform sampler2D uSource;
uniform vec2 uTexel;

out vec4 FragColor;

void main()
{
    vec3 c = texture(uSource, vUv).rgb * 4.0;
    c += texture(uSource, vUv + vec2(uTexel.x, 0.0)).rgb * 2.0;
    c += texture(uSource, vUv - vec2(uTexel.x, 0.0)).rgb * 2.0;
    c += texture(uSource, vUv + vec2(0.0, uTexel.y)).rgb * 2.0;
    c += texture(uSource, vUv - vec2(0.0, uTexel.y)).rgb * 2.0;
    c += texture(uSource, vUv + uTexel).rgb;
    c += texture(uSource, vUv - uTexel).rgb;
    c += texture(uSource, vUv + vec2(uTexel.x, -uTexel.y)).rgb;
    c += texture(uSource, vUv + vec2(-uTexel.x, uTexel.y)).rgb;
    FragColor = vec4(c / 16.0 * 0.85, 1.0);
}
const float PI = 3.14159265;

const int MAT_SOLID = 0;
const int MAT_PLANT = 1;
const int MAT_LEAVES = 2;
const int MAT_WATER = 3;
const int MAT_LAVA = 4;
const int MAT_GLASS = 5;
const int MAT_ICE = 6;
const int MAT_SNOW = 7;
const int MAT_HANGING = 8;
const int MAT_METAL = 9;
const int MAT_ORE = 10;
const int MAT_GLOWING = 11;
const int MAT_POLISHED = 12;
const int MAT_FLAME = 13;
const int MAT_PORTAL = 14;
const int MAT_FLOATING = 15;
const int MAT_UNDERWATER_PLANT = 16;
const int MAT_TALL_PLANT = 17;

int tagFace(float tag) { return int(tag + 0.5) & 7; }
int tagBlock(float tag) { return (int(tag + 0.5) >> 3) & 4095; }
bool tagTop(float tag) { return int(tag + 0.5) >= 32768; }

float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

float hash12(vec2 p)
{
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float ditherNoise(vec2 pixel)
{
    return fract(52.9829189 * fract(dot(pixel, vec2(0.06711056, 0.00583715))));
}

vec3 breeze(vec3 p, float t, float rain)
{
    float gust = 0.55 + 0.45 * sin(t * 0.31 + p.x * 0.021 + p.z * 0.017);
    gust *= 1.0 + rain * 0.9;
    float a = sin(t * 1.83 + p.x * 0.71 + p.z * 0.43 + p.y * 0.27);
    float b = sin(t * 1.21 - p.z * 0.66 + p.x * 0.29 + 1.7);
    float c = sin(t * 3.70 + p.x * 1.9 + p.z * 2.3) * 0.25;
    return vec3(a + c, 0.0, b - c) * gust;
}

float waterSwell(vec2 p, float t)
{
    float w = sin(p.x * 0.62 + t * 1.35) * 0.55 + sin(p.y * 0.51 - t * 1.05) * 0.45;
    w += sin((p.x + p.y) * 1.13 + t * 2.1) * 0.25;
    return w;
}

vec3 waveOffset(vec3 world, int material, bool top, float t, float rain)
{
    if (material == MAT_PLANT || material == MAT_TALL_PLANT)
        return top ? breeze(world, t, rain) * 0.085 : vec3(0.0);
    if (material == MAT_LEAVES)
    {
        vec3 b = breeze(world, t * 1.15, rain) * 0.04;
        b.y = sin(t * 2.3 + world.x * 1.7 + world.z * 1.3) * 0.015;
        return b;
    }
    if (material == MAT_HANGING) return breeze(world, t * 0.9, rain) * 0.045;
    if (material == MAT_UNDERWATER_PLANT)
        return top ? vec3(sin(t * 1.1 + world.x * 0.8), 0.0, cos(t * 0.9 + world.z * 0.7)) * 0.10
                   : vec3(0.0);
    if (material == MAT_WATER && top) return vec3(0.0, waterSwell(world.xz, t) * 0.028 - 0.03, 0.0);
    if (material == MAT_FLOATING) return vec3(0.0, waterSwell(world.xz, t) * 0.028 - 0.02, 0.0);
    if (material == MAT_LAVA && top) return vec3(0.0, sin(t * 0.7 + world.x * 0.9 + world.z * 0.6) * 0.02 - 0.02, 0.0);
    return vec3(0.0);
}

const float SHADOW_BEND = 0.85;

vec2 bendShadow(vec2 p)
{
    float d = length(p);
    return p / (d * SHADOW_BEND + (1.0 - SHADOW_BEND));
}

float bendScale(vec2 p)
{
    float d = length(p) * SHADOW_BEND + (1.0 - SHADOW_BEND);
    return d * d / (1.0 - SHADOW_BEND);
}

float duskAmount(float sunHeight)
{
    return smoothstep(-0.22, 0.0, sunHeight) * (1.0 - smoothstep(0.02, 0.38, sunHeight));
}

uniform vec3 uSkyTint;

vec3 skyTint()
{
    return dot(uSkyTint, uSkyTint) > 0.0 ? uSkyTint : vec3(1.0);
}

vec3 skyRadiance(vec3 dir, vec3 sun, float rain)
{
    float s = sun.y;
    float day = smoothstep(-0.12, 0.30, s);
    float dusk = duskAmount(s);
    float up = clamp(dir.y, 0.0, 1.0);
    float horizon = pow(1.0 - up, 3.5);

    vec3 zenithDay = vec3(0.16, 0.34, 0.86) * skyTint();
    vec3 horizonDay = vec3(0.60, 0.77, 1.00) * mix(vec3(1.0), skyTint(), 0.5);
    vec3 zenithNight = vec3(0.004, 0.007, 0.020);
    vec3 horizonNight = vec3(0.014, 0.022, 0.050);

    vec3 zenith = mix(zenithNight, zenithDay, day);
    vec3 rim = mix(horizonNight, horizonDay, day);
    vec3 colour = mix(zenith, rim, horizon);

    float toward = dot(dir, sun) * 0.5 + 0.5;
    vec3 glow = mix(vec3(0.85, 0.30, 0.38), vec3(1.15, 0.50, 0.16), toward);
    colour = mix(colour, glow * (0.35 + 0.9 * pow(toward, 3.0)), dusk * horizon * 0.85);
    colour += vec3(0.30, 0.18, 0.42) * dusk * (1.0 - horizon) * 0.25;

    float halo = pow(max(dot(dir, sun), 0.0), 10.0);
    colour += vec3(1.0, 0.80, 0.58) * halo * (0.18 * day + 0.6 * dusk);

    float moonHalo = pow(max(dot(dir, -sun), 0.0), 18.0);
    colour += vec3(0.20, 0.26, 0.40) * moonHalo * (1.0 - day) * 0.25;

    if (dir.y < 0.0) colour *= mix(1.0, 0.35, clamp(-dir.y * 2.5, 0.0, 1.0));

    float grey = luma(colour);
    colour = mix(colour, vec3(grey) * vec3(0.92, 0.96, 1.0), rain * 0.85);
    colour *= 1.0 - rain * 0.45;
    return colour * 1.15;
}

vec3 waterFogColour(vec3 skyAmbient)
{
    return vec3(0.025, 0.11, 0.16) * (0.25 + luma(skyAmbient) * 0.9);
}
#version 330 core
#include "common.glsl"

in vec2 vUv;

uniform sampler2D uScene;
uniform sampler2D uDepth;
uniform sampler2D uHandDepth;
uniform sampler2DShadow uShadowMap;
uniform sampler2D uNoise;

uniform mat4 uInvProjection;
uniform mat4 uInvView;
uniform mat4 uShadowViewProj;
uniform vec3 uCameraPos;
uniform vec3 uSunDirection;
uniform vec3 uLightDir;
uniform vec3 uLightColour;
uniform vec3 uSkyAmbient;
uniform vec3 uBackdrop;
uniform float uShadowStrength;
uniform float uRain;
uniform float uTime;
uniform float uRenderDistance;
uniform float uEyeSkyLight;
uniform int uDimension;
uniform int uUnderwater;
uniform int uInLava;
uniform vec2 uScreenSize;

out vec4 FragColor;

float lightAt(vec3 world)
{
    vec4 clip = uShadowViewProj * vec4(world, 1.0);
    if (max(abs(clip.x), abs(clip.y)) >= 1.0) return 1.0;
    vec2 bent = bendShadow(clip.xy);
    return texture(uShadowMap, vec3(bent * 0.5 + 0.5, clip.z * 0.5 + 0.5 - 0.0005));
}

float phase(float cosTheta, float g)
{
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * PI * pow(1.0 + g2 - 2.0 * g * cosTheta, 1.5));
}

void main()
{
    vec3 colour = texture(uScene, vUv).rgb;

    if (texture(uHandDepth, vUv).r < 1.0)
    {
        FragColor = vec4(colour, 1.0);
        return;
    }

    float depth = texture(uDepth, vUv).r;
    vec4 view = uInvProjection * vec4(vUv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec3 viewPos = view.xyz / view.w;
    vec3 dir = normalize(mat3(uInvView) * viewPos);
    bool sky = depth >= 0.99999;
    float dist = sky ? uRenderDistance * 1.2 : length(viewPos);
    vec3 sun = normalize(uSunDirection);

    if (uDimension == 0)
    {
        if (!sky)
        {
            vec3 fogColour = skyRadiance(dir, sun, uRain);
            float border = smoothstep(uRenderDistance * 0.60, uRenderDistance * 0.97, dist);
            float heightFade = exp(-max(uCameraPos.y + dir.y * dist * 0.5 - 62.0, 0.0) / 48.0);
            float density = (0.0011 + uRain * 0.0065 + duskAmount(sun.y) * 0.0012) * heightFade;
            float haze = 1.0 - exp(-dist * density);
            float caves = mix(0.08, 1.0, uEyeSkyLight);
            colour = mix(colour, fogColour * caves, haze);
            colour = mix(colour, fogColour, border);
        }

        if (uShadowStrength > 0.0 && uUnderwater == 0 && uEyeSkyLight > 0.01)
        {
            float reach = min(dist, 80.0);
            const int STEPS = 9;
            float jitter = hash12(gl_FragCoord.xy + fract(uTime) * 61.0);
            float lit = 0.0;
            for (int i = 0; i < STEPS; ++i)
            {
                float t = (float(i) + jitter) / float(STEPS);
                lit += lightAt(uCameraPos + dir * reach * t * t);
            }
            lit /= float(STEPS);

            float cosTheta = dot(dir, uLightDir);
            float scatter = min(phase(cosTheta, 0.65), 1.2) * 0.9 + 0.035;
            float morning = duskAmount(sun.y);
            float density = 0.0009 + morning * 0.0065 + uRain * 0.002;
            float amount = 1.0 - exp(-reach * density);
            colour += uLightColour * lit * scatter * amount * uShadowStrength * uEyeSkyLight;
        }
    }
    else
    {
        float density = uDimension == 1 ? 0.0085 : 0.006;
        float haze = 1.0 - exp(-dist * density);
        float border = smoothstep(uRenderDistance * 0.55, uRenderDistance * 0.95, dist);
        if (!sky) colour = mix(colour, uBackdrop * 0.6, max(haze * 0.7, border));
    }

    if (uUnderwater == 1)
    {
        vec3 fog = waterFogColour(uSkyAmbient) * (0.2 + 0.8 * uEyeSkyLight);
        float amount = 1.0 - exp(-dist * 0.075);
        colour = mix(colour * vec3(0.55, 0.85, 0.95), fog, amount);
    }

    if (uInLava == 1)
    {
        float amount = 1.0 - exp(-dist * 0.9);
        colour = mix(colour, vec3(1.6, 0.45, 0.06), amount);
    }

    FragColor = vec4(colour, 1.0);
}
#version 330 core
#include "common.glsl"

in vec2 vUv;
uniform sampler2D uScene;
uniform sampler2D uBloom;
uniform sampler2D uDither;
uniform float uExposure;
uniform float uTime;
uniform float uRain;
uniform int uUnderwater;
uniform int uDimension;

out vec4 FragColor;

vec3 filmic(vec3 x)
{
    vec3 curve = 1.0 - exp(-x * 1.25);
    vec3 shoulder = x / (x + 0.9) * 1.9;
    return mix(curve, min(shoulder, vec3(1.0)), smoothstep(0.6, 1.0, curve) * 0.25);
}

void main()
{
    vec3 scene = texture(uScene, vUv).rgb;
    vec3 bloom = texture(uBloom, vUv).rgb;

    float bloomStrength = 0.55 + (uUnderwater == 1 ? 0.6 : 0.0) + uRain * 0.3;
    vec3 colour = scene + bloom * bloomStrength;
    colour *= uExposure;

    colour = filmic(colour);

    float grey = luma(colour);
    float vibrance = 0.22 * (1.0 - smoothstep(0.0, 0.6, max(max(colour.r, colour.g), colour.b) - min(min(colour.r, colour.g), colour.b)));
    colour = mix(vec3(grey), colour, 1.12 + vibrance);
    colour = max(colour, vec3(0.0));

    colour = pow(colour, vec3(1.0 / 2.2));

    vec2 centre = vUv - 0.5;
    float vignette = 1.0 - dot(centre, centre) * 0.42;
    colour *= vignette;

    ivec2 cell = ivec2(mod(gl_FragCoord.xy, vec2(textureSize(uDither, 0))));
    float threshold = (texelFetch(uDither, cell, 0).r * 15.0 + 0.5) / 16.0;
    colour += (threshold - 0.5) / 255.0;
    FragColor = vec4(clamp(colour, 0.0, 1.0), 1.0);
}
#version 330 core

out vec2 vUv;

void main()
{
    vec2 corner = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));
    vUv = corner;
    gl_Position = vec4(corner * 2.0 - 1.0, 0.0, 1.0);
}
#version 330 core

in vec2 vUV;
uniform sampler2D uAtlas;

out vec4 FragColor;

void main()
{
    if (texture(uAtlas, vUV).a < 0.1) discard;
    FragColor = vec4(1.0);
}
#version 330 core
#include "common.glsl"

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aUV;
layout (location = 2) in float aShade;
layout (location = 3) in float aSkyLight;
layout (location = 4) in float aBlockLight;
layout (location = 5) in float aFace;

uniform mat4 uShadowViewProj;
uniform vec3 uChunkOffset;
uniform sampler2D uMaterials;
uniform float uTime;
uniform float uRain;

out vec2 vUV;

void main()
{
    int block = tagBlock(aFace);
    int material = int(texelFetch(uMaterials, ivec2(block, 0), 0).r * 255.0 + 0.5);
    vec3 world = aPos + uChunkOffset;
    world += waveOffset(world, material, tagTop(aFace), uTime, uRain);

    vec4 clip = uShadowViewProj * vec4(world, 1.0);
    clip.xy = bendShadow(clip.xy);
    gl_Position = clip;
    vUV = aUV;
}
#version 330 core
#include "common.glsl"

in vec2 vUv;

uniform mat4 uInvViewProj;
uniform vec3 uCameraPos;
uniform vec3 uSunDirection;
uniform vec3 uLightColour;
uniform vec3 uSkyAmbient;
uniform float uTime;
uniform float uRain;
uniform sampler2D uNoise;
uniform sampler2D uSunTex;
uniform sampler2D uMoonTex;
uniform int uHasSun;
uniform int uHasMoon;
uniform int uMoonPhase;

out vec4 FragColor;

const float CLOUD_BASE = 192.0;
const float CLOUD_DEPTH = 22.0;

float cloudField(vec2 p, float coverage)
{
    vec2 drift = vec2(uTime * 0.9, uTime * 0.35);
    vec2 q = (p + drift) / 1024.0;
    float n = texture(uNoise, q).r * 0.52;
    n += texture(uNoise, q * 2.7 + 0.31).g * 0.28;
    n += texture(uNoise, q * 6.1 + 0.77).b * 0.14;
    n += texture(uNoise, q * 13.0 + 0.13).a * 0.06;
    return clamp((n - (1.0 - coverage)) / max(coverage, 0.05) * 1.6, 0.0, 1.0);
}

vec4 clouds(vec3 dir, vec3 sun)
{
    if (dir.y < 0.015) return vec4(0.0);

    float coverage = mix(0.40, 0.80, uRain);
    float jitter = ditherNoise(gl_FragCoord.xy);

    float density = 0.0;
    float lit = 0.0;
    const int STEPS = 4;
    for (int i = 0; i < STEPS; ++i)
    {
        float layer = (float(i) + jitter) / float(STEPS);
        float height = CLOUD_BASE + layer * CLOUD_DEPTH;
        float t = (height - uCameraPos.y) / dir.y;
        if (t <= 0.0) continue;
        vec2 p = uCameraPos.xz + dir.xz * t;
        float shape = cloudField(p, coverage) * (1.0 - abs(layer - 0.45) * 1.1);
        if (shape <= 0.0) continue;
        vec2 towardLight = p + sun.xz * 18.0 / max(abs(sun.y), 0.25);
        float occlusion = cloudField(towardLight, coverage);
        lit += shape * (1.0 - occlusion * 0.75) * (0.4 + 0.6 * layer);
        density += shape;
    }

    density /= float(STEPS);
    lit /= float(STEPS);
    if (density <= 0.0) return vec4(0.0);

    float alpha = 1.0 - exp(-density * 3.2);
    float fade = smoothstep(0.015, 0.20, dir.y);
    float silver = pow(max(dot(dir, sun), 0.0), 6.0);

    vec3 shadowSide = uSkyAmbient * 0.75 + vec3(0.02);
    vec3 sunSide = uLightColour * (0.55 + 1.6 * silver);
    vec3 colour = shadowSide + sunSide * lit / max(density, 0.001);
    colour = mix(colour, vec3(luma(colour)), uRain * 0.6);
    return vec4(colour, alpha * fade);
}

void main()
{
    vec4 farPoint = uInvViewProj * vec4(vUv * 2.0 - 1.0, 1.0, 1.0);
    vec3 dir = normalize(farPoint.xyz / farPoint.w - uCameraPos);
    vec3 sun = normalize(uSunDirection);

    vec3 colour = skyRadiance(dir, sun, uRain);

    float day = smoothstep(-0.10, 0.10, sun.y);
    float clear = 1.0 - uRain;

    if (dir.y > 0.0 && day < 1.0)
    {
        vec3 cell = floor(dir * 260.0);
        float star = hash12(cell.xy + cell.z * 17.31);
        float twinkle = 0.75 + 0.25 * sin(uTime * 3.0 + star * 60.0);
        float bright = smoothstep(0.9965, 1.0, star) * twinkle;
        colour += vec3(0.85, 0.90, 1.0) * bright * 1.6 * (1.0 - day) * clear * smoothstep(0.0, 0.25, dir.y);
    }

    float sunDot = dot(dir, sun);
    vec3 sunColour = mix(vec3(1.0, 0.45, 0.15), vec3(1.0, 0.93, 0.82), smoothstep(0.0, 0.35, sun.y));
    vec3 sideways = normalize(cross(sun, vec3(0.0, 0.0, 1.0)));
    vec3 upwards = cross(sideways, sun);
    float aboveGround = smoothstep(-0.05, 0.02, dir.y);
    if (uHasSun == 1)
    {
        if (sunDot > 0.0)
        {
            vec2 local = vec2(dot(dir, sideways), dot(dir, upwards)) / sunDot / 0.3;
            if (abs(local.x) < 1.0 && abs(local.y) < 1.0)
            {
                vec4 texel = texture(uSunTex, local * 0.5 + 0.5);
                colour += sunColour * texel.rgb * texel.a * 9.0 * clear * aboveGround;
            }
        }
    }
    else
    {
        float disc = smoothstep(0.99935, 0.99965, sunDot);
        disc *= mix(0.72, 1.0, smoothstep(0.99935, 0.99995, sunDot));
        colour += sunColour * disc * 28.0 * clear * aboveGround;
    }

    float moonDot = dot(dir, -sun);
    if (uHasMoon == 1)
    {
        if (moonDot > 0.0)
        {
            vec2 local = vec2(dot(dir, -sideways), dot(dir, upwards)) / moonDot / 0.2;
            if (abs(local.x) < 1.0 && abs(local.y) < 1.0)
            {
                vec2 cell = vec2(float(uMoonPhase % 4), float(uMoonPhase / 4));
                vec4 texel = texture(uMoonTex, (cell + local * 0.5 + 0.5) / vec2(4.0, 2.0));
                colour += texel.rgb * texel.a * 2.4 * clear * aboveGround;
            }
        }
    }
    else
    {
        float moon = smoothstep(0.99950, 0.99975, moonDot);
        float craters = 0.82 + 0.18 * texture(uNoise, dir.xz * 7.0).r;
        colour += vec3(0.75, 0.80, 0.92) * moon * craters * 2.4 * clear * aboveGround;
    }

    vec4 cloud = clouds(dir, sun.y > -0.05 ? sun : -sun);
    colour = mix(colour, cloud.rgb, cloud.a);

    FragColor = vec4(colour, 1.0);
}
#version 330 core
#include "common.glsl"

in vec2 vUv;
uniform sampler2D uImage;
uniform vec2 uTexel;

out vec4 FragColor;

void main()
{
    vec3 centre = texture(uImage, vUv).rgb;
    float lc = luma(centre);
    float nw = luma(texture(uImage, vUv + vec2(-1.0, 1.0) * uTexel).rgb);
    float ne = luma(texture(uImage, vUv + vec2(1.0, 1.0) * uTexel).rgb);
    float sw = luma(texture(uImage, vUv + vec2(-1.0, -1.0) * uTexel).rgb);
    float se = luma(texture(uImage, vUv + vec2(1.0, -1.0) * uTexel).rgb);

    float lo = min(lc, min(min(nw, ne), min(sw, se)));
    float hi = max(lc, max(max(nw, ne), max(sw, se)));
    if (hi - lo < max(0.045, hi * 0.15))
    {
        FragColor = vec4(centre, 1.0);
        return;
    }

    vec2 dir = vec2(-((nw + ne) - (sw + se)), (nw + sw) - (ne + se));
    float reduce = max((nw + ne + sw + se) * 0.03125, 0.0078125);
    float scale = 1.0 / (min(abs(dir.x), abs(dir.y)) + reduce);
    dir = clamp(dir * scale, vec2(-6.0), vec2(6.0)) * uTexel;

    vec3 inner = 0.5 * (texture(uImage, vUv + dir * (1.0 / 3.0 - 0.5)).rgb +
                       texture(uImage, vUv + dir * (2.0 / 3.0 - 0.5)).rgb);
    vec3 wide = inner * 0.5 + 0.25 * (texture(uImage, vUv - dir * 0.5).rgb +
                                     texture(uImage, vUv + dir * 0.5).rgb);
    float lw = luma(wide);
    FragColor = vec4((lw < lo || lw > hi) ? inner : wide, 1.0);
}
#version 330 core
#include "common.glsl"

in vec2 vUV;
in vec3 vTint;
in float vTintSelective;
in float vShade;
in float vSkyLight;
in float vBlockLight;
in vec3 vWorldPos;
in vec3 vViewPos;
flat in int vFace;
flat in int vBlock;
flat in int vMaterial;
flat in vec4 vInfo;

uniform sampler2D uAtlas;
uniform sampler2D uNormalAtlas;
uniform sampler2D uSpecularAtlas;
uniform sampler2DShadow uShadowMap;
uniform sampler2D uNoise;
uniform sampler2D uSceneCopy;
uniform sampler2D uDepthCopy;

uniform mat4 uView;
uniform mat4 uProjection;
uniform mat4 uShadowViewProj;
uniform vec3 uCameraPos;
uniform vec3 uSunDirection;
uniform vec3 uLightDir;
uniform vec3 uLightColour;
uniform vec3 uSkyAmbient;
uniform float uShadowStrength;
uniform float uDaylight;
uniform float uAmbient;
uniform float uRain;
uniform float uTime;
uniform int uDimension;
uniform int uPass;
uniform int uUnderwater;
uniform int uPbrEnabled;
uniform vec2 uScreenSize;
uniform float uNear;
uniform float uFar;

out vec4 FragColor;

const vec3 FACE_NORMAL[6] = vec3[6](
    vec3(1.0, 0.0, 0.0), vec3(-1.0, 0.0, 0.0),
    vec3(0.0, 1.0, 0.0), vec3(0.0, -1.0, 0.0),
    vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, -1.0));
const vec3 FACE_TANGENT[6] = vec3[6](
    vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, 1.0),
    vec3(1.0, 0.0, 0.0), vec3(1.0, 0.0, 0.0),
    vec3(1.0, 0.0, 0.0), vec3(1.0, 0.0, 0.0));
const vec3 FACE_BITANGENT[6] = vec3[6](
    vec3(0.0, 1.0, 0.0), vec3(0.0, 1.0, 0.0),
    vec3(0.0, 0.0, -1.0), vec3(0.0, 0.0, -1.0),
    vec3(0.0, 1.0, 0.0), vec3(0.0, 1.0, 0.0));
const float FACE_SHADE[6] = float[6](0.72, 0.72, 1.0, 0.5, 0.86, 0.86);

const vec2 DISC[12] = vec2[12](
    vec2(0.9439, 0.0812), vec2(-0.3471, 0.7955), vec2(-0.7653, -0.4316), vec2(0.2817, -0.8724),
    vec2(0.4720, 0.4113), vec2(-0.5103, 0.1802), vec2(0.0621, -0.4392), vec2(0.2133, 0.1520),
    vec2(-0.1504, 0.4720), vec2(0.6632, -0.3810), vec2(-0.3920, -0.7712), vec2(-0.9010, 0.2210));

float linearDepth(float d)
{
    float z = d * 2.0 - 1.0;
    return 2.0 * uNear * uFar / (uFar + uNear - z * (uFar - uNear));
}

float shadowAt(vec3 world, vec3 normal)
{
    vec4 probe = uShadowViewProj * vec4(world, 1.0);
    float texelWorld = 2.0 * 96.0 / 2048.0 * bendScale(probe.xy);
    vec3 shifted = world + normal * (0.03 + texelWorld * 1.1);

    vec4 clip = uShadowViewProj * vec4(shifted, 1.0);
    float edge = max(abs(clip.x), abs(clip.y));
    if (edge >= 1.0 || clip.z > 1.0 || clip.z < -1.0) return 1.0;

    vec2 bent = bendShadow(clip.xy);
    vec3 coord = vec3(bent * 0.5 + 0.5, clip.z * 0.5 + 0.5 - 0.0002);

    float radius = 1.4 / 2048.0;

    float lit = 0.0;
    for (int i = 0; i < 12; ++i)
        lit += texture(uShadowMap, vec3(coord.xy + DISC[i] * radius, coord.z));
    lit /= 12.0;

    return mix(lit, 1.0, smoothstep(0.80, 0.98, edge));
}

vec3 waterNormal(vec2 p)
{
    float t = uTime;
    vec2 a = p * 0.045 + vec2(t * 0.011, t * 0.006);
    vec2 b = p * 0.110 + vec2(-t * 0.017, t * 0.013);
    vec2 c = p * 0.260 + vec2(t * 0.021, -t * 0.024);
    float e = 0.04;
    float hx = texture(uNoise, a + vec2(e, 0.0)).r - texture(uNoise, a - vec2(e, 0.0)).r;
    float hz = texture(uNoise, a + vec2(0.0, e)).r - texture(uNoise, a - vec2(0.0, e)).r;
    hx += (texture(uNoise, b + vec2(e, 0.0)).g - texture(uNoise, b - vec2(e, 0.0)).g) * 0.6;
    hz += (texture(uNoise, b + vec2(0.0, e)).g - texture(uNoise, b - vec2(0.0, e)).g) * 0.6;
    hx += (texture(uNoise, c + vec2(e, 0.0)).b - texture(uNoise, c - vec2(e, 0.0)).b) * 0.35;
    hz += (texture(uNoise, c + vec2(0.0, e)).b - texture(uNoise, c - vec2(0.0, e)).b) * 0.35;
    float bump = 0.55 * (1.0 + uRain * 0.6);
    return normalize(vec3(-hx * bump, 1.0, -hz * bump));
}

bool traceScreen(vec3 origin, vec3 dir, out vec2 hitUv)
{
    vec3 ray = origin;
    float stride = 0.35 + length(origin) * 0.03;
    vec3 stepRay = dir * stride;
    float jitter = ditherNoise(gl_FragCoord.xy);
    ray += stepRay * jitter;

    for (int i = 0; i < 24; ++i)
    {
        ray += stepRay;
        vec4 clip = uProjection * vec4(ray, 1.0);
        if (clip.w <= 0.0) return false;
        vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
        if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return false;

        float scene = linearDepth(texture(uDepthCopy, uv).r);
        float depth = -ray.z;
        float gap = depth - scene;
        if (gap > 0.0 && gap < length(stepRay) * 2.5 + 0.4)
        {
            vec3 lo = ray - stepRay;
            vec3 hi = ray;
            for (int j = 0; j < 5; ++j)
            {
                vec3 mid = (lo + hi) * 0.5;
                vec4 m = uProjection * vec4(mid, 1.0);
                vec2 muv = m.xy / m.w * 0.5 + 0.5;
                if (-mid.z > linearDepth(texture(uDepthCopy, muv).r)) hi = mid;
                else lo = mid;
            }
            vec4 h = uProjection * vec4(hi, 1.0);
            hitUv = h.xy / h.w * 0.5 + 0.5;
            return texture(uDepthCopy, hitUv).r < 0.99999;
        }
        stepRay *= 1.28;
    }
    return false;
}

vec3 skyLit(vec3 dir)
{
    return skyRadiance(dir, normalize(uSunDirection), uRain);
}

vec3 shadeWater(vec3 albedoTex, vec3 viewDir, float sky)
{
    vec3 n = waterNormal(vWorldPos.xz);
    bool topFace = vFace == 2;
    if (!topFace) n = FACE_NORMAL[clamp(vFace, 0, 5)];

    bool below = uUnderwater == 1;
    if (below) n = -n;

    float cosV = max(dot(n, viewDir), 0.0);
    float fresnel = 0.02 + 0.98 * pow(1.0 - cosV, 5.0);

    vec2 screen = gl_FragCoord.xy / uScreenSize;
    float surface = linearDepth(gl_FragCoord.z);
    float behindDepth = linearDepth(texture(uDepthCopy, screen).r);
    float thickness = max(behindDepth - surface, 0.0);

    vec3 viewNormal = mat3(uView) * n;
    vec2 bend = viewNormal.xy * 0.045 * clamp(thickness * 0.35, 0.0, 1.0);
    vec2 refractUv = clamp(screen + bend, vec2(0.001), vec2(0.999));
    float refractDepth = linearDepth(texture(uDepthCopy, refractUv).r);
    if (refractDepth < surface) refractUv = screen;
    else thickness = max(refractDepth - surface, 0.0);

    vec3 behind = texture(uSceneCopy, refractUv).rgb;
    vec3 fog = waterFogColour(uSkyAmbient) * (0.15 + 0.85 * sky);
    vec3 absorb = exp(-thickness * vec3(0.38, 0.085, 0.060));
    vec3 body = behind * absorb + fog * (1.0 - absorb.g);
    body *= mix(vec3(1.0), albedoTex * 1.6, 0.18);

    if (below)
    {
        float through = smoothstep(0.0, 0.25, cosV);
        return mix(fog * 0.6, behind * vec3(0.55, 0.85, 0.95), through);
    }

    vec3 reflectDir = reflect(-viewDir, n);
    vec3 reflection = skyLit(reflectDir) * mix(0.08, 1.0, sky * sky);
    vec3 viewReflect = normalize(mat3(uView) * reflectDir);
    vec2 hitUv;
    if (topFace && traceScreen(vViewPos, viewReflect, hitUv))
    {
        vec2 fadeEdge = smoothstep(vec2(0.0), vec2(0.08), hitUv) * (1.0 - smoothstep(vec2(0.92), vec2(1.0), hitUv));
        reflection = mix(reflection, texture(uSceneCopy, hitUv).rgb, fadeEdge.x * fadeEdge.y);
    }

    vec3 colour = mix(body, reflection, fresnel);

    if (topFace)
    {
        float edge = 1.0 - smoothstep(0.05, 0.55, thickness);
        float bubbles = texture(uNoise, vWorldPos.xz * 0.9 + vec2(uTime * 0.05, -uTime * 0.04)).a;
        float foam = edge * smoothstep(0.45, 0.75, bubbles + edge * 0.35);
        vec3 foamLight = uSkyAmbient * sky * sky + uLightColour * 0.6 * smoothstep(0.5, 0.9, sky);
        colour = mix(colour, vec3(0.85, 0.92, 0.95) * foamLight, foam * 0.7);
    }

    vec3 h = normalize(uLightDir + viewDir);
    float spec = pow(max(dot(n, h), 0.0), 220.0) * 18.0;
    float sun = uShadowStrength > 0.0 ? shadowAt(vWorldPos, vec3(0.0, 1.0, 0.0)) : 1.0;
    colour += uLightColour * spec * fresnel * sun * smoothstep(0.5, 0.9, sky) * (1.0 - uRain);
    return colour;
}

void main()
{
    vec2 uv = vUV;
    vec4 texel = texture(uAtlas, uv);
    if (texel.a < 0.1) discard;
    vec3 biomeTint = vTintSelective > 0.5 ? mix(vec3(1.0), vTint, step(texel.r + 0.02, texel.g)) : vTint;
    texel.rgb *= biomeTint;

    int material = vMaterial;
    bool chunk = vBlock > 0;
    bool plantQuad = vFace == 6;
    vec3 viewDir = normalize(uCameraPos - vWorldPos);

    vec3 geoNormal;
    vec3 tangent = vec3(1.0, 0.0, 0.0);
    vec3 bitangent = vec3(0.0, 0.0, -1.0);
    if (chunk && vFace < 6)
    {
        geoNormal = FACE_NORMAL[vFace];
        tangent = FACE_TANGENT[vFace];
        bitangent = FACE_BITANGENT[vFace];
    }
    else if (chunk && plantQuad)
    {
        geoNormal = vec3(0.0, 1.0, 0.0);
    }
    else
    {
        geoNormal = normalize(cross(dFdx(vWorldPos), dFdy(vWorldPos)));
        if (dot(geoNormal, viewDir) < 0.0) geoNormal = -geoNormal;
        if (any(isnan(geoNormal))) geoNormal = vec3(0.0, 1.0, 0.0);
    }

    vec3 albedo = pow(texel.rgb, vec3(2.2));
    float sky = clamp(vSkyLight, 0.0, 1.0);
    float torch = clamp(vBlockLight, 0.0, 1.0);

    float ao = 1.0;
    if (chunk && vFace < 6) ao = clamp(vShade / FACE_SHADE[vFace], 0.0, 1.0);
    else if (!chunk) ao = mix(1.0, clamp(vShade, 0.0, 1.0), 0.35);

    if (material == MAT_WATER && uPass == 1)
    {
        vec3 waterTex = pow(texel.rgb, vec3(2.2));
        FragColor = vec4(shadeWater(waterTex, viewDir, sky), 1.0);
        return;
    }

    vec3 normal = geoNormal;
    float smoothness = vInfo.b;
    float metal = vInfo.a;
    float emission = vInfo.g;

    if (uPbrEnabled == 1 && chunk && !plantQuad)
    {
        vec4 normalSample = texture(uNormalAtlas, uv);
        vec4 specularSample = texture(uSpecularAtlas, uv);
        vec2 xy = normalSample.rg * 2.0 - 1.0;
        float z = sqrt(clamp(1.0 - dot(xy, xy), 0.0, 1.0));
        normal = normalize(tangent * xy.x + bitangent * xy.y + geoNormal * z);
        ao *= mix(1.0, normalSample.b, 0.6);
        smoothness = max(smoothness, specularSample.r);
        metal = max(metal, specularSample.g > 0.9 ? 1.0 : specularSample.g);
        float pbrEmission = specularSample.a > 0.996 ? 0.0 : specularSample.a;
        emission = max(emission, pbrEmission);
    }

    float wet = 0.0;
    if (uRain > 0.0 && uDimension == 0 && chunk)
    {
        float exposed = smoothstep(0.86, 0.97, sky) * max(geoNormal.y, 0.0);
        float patches = smoothstep(0.42, 0.62, texture(uNoise, vWorldPos.xz * 0.018).g);
        wet = uRain * exposed * mix(0.45, 1.0, patches);
        if (material == MAT_PLANT || material == MAT_LEAVES || material == MAT_TALL_PLANT) wet *= 0.3;
        albedo *= 1.0 - wet * 0.32;
        smoothness = max(smoothness, wet * 0.82);
    }

    float NdotL = dot(normal, uLightDir);
    bool foliage = material == MAT_PLANT || material == MAT_LEAVES || material == MAT_HANGING ||
                   material == MAT_TALL_PLANT || material == MAT_UNDERWATER_PLANT ||
                   material == MAT_FLOATING;

    float diffuse = foliage ? mix(0.55, 1.0, max(NdotL, 0.0)) : max((NdotL + 0.28) / 1.28, 0.0);
    if (plantQuad) diffuse = 0.55 + 0.45 * max(uLightDir.y, 0.0);

    float shadow = 1.0;
    if (uShadowStrength > 0.0 && uPass != 2 && diffuse > 0.0 && sky > 0.05)
        shadow = shadowAt(vWorldPos, foliage ? vec3(0.0, 1.0, 0.0) : geoNormal);

    float sunReach = smoothstep(0.30, 0.80, sky);
    if (uPass == 2) sunReach = smoothstep(0.30, 0.90, sky);
    vec3 direct = uLightColour * diffuse * mix(1.0, shadow, uShadowStrength) * sunReach;
    if (uUnderwater == 1 && uPass != 2)
    {
        vec2 q = vWorldPos.xz * 0.35 + vWorldPos.y * 0.12;
        float caustic = texture(uNoise, q * 0.21 + vec2(uTime * 0.020, uTime * 0.013)).g +
                        texture(uNoise, q * 0.17 - vec2(uTime * 0.017, -uTime * 0.021)).b;
        caustic = pow(1.0 - abs(caustic - 1.0), 6.0);
        direct *= vec3(0.16, 0.42, 0.48) * (0.55 + 1.6 * caustic);
    }

    if (foliage)
    {
        float behind = pow(max(dot(-viewDir, uLightDir), 0.0), 6.0);
        direct += uLightColour * albedo * behind * 1.4 * shadow * sunReach;
    }

    float skyTerm = sky * sky;
    float faceLight = mix(0.58, 1.0, geoNormal.y * 0.5 + 0.5) * (1.0 - 0.10 * abs(geoNormal.x));
    vec3 ambient = uSkyAmbient * skyTerm * faceLight * (0.85 + 0.15 * normal.y);

    vec3 torchColour = vec3(1.0, 0.58, 0.26);
    vec3 torchLight = torchColour * (pow(torch, 3.0) * 1.25 + pow(torch, 1.5) * 0.10);

    vec3 floorLight = vec3(0.006, 0.007, 0.011) * (1.0 - sky);
    if (uDimension == 1) floorLight = uSkyAmbient * 0.22 + vec3(0.02, 0.008, 0.004);
    if (uDimension == 2) floorLight = uSkyAmbient * 0.20;

    vec3 light = direct + (ambient + (torchLight + floorLight) * (0.55 + 0.45 * faceLight)) * ao;
    vec3 colour = albedo * light;

    vec3 f0 = mix(vec3(0.04), albedo, metal);
    if (smoothness > 0.05)
    {
        vec3 h = normalize(uLightDir + viewDir);
        float power = exp2(2.0 + smoothness * 10.0);
        float normaliser = (power + 8.0) / (8.0 * PI);
        vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - max(dot(h, viewDir), 0.0), 5.0);
        float highlight = normaliser * pow(max(dot(normal, h), 0.0), power);
        colour += uLightColour * fresnel * highlight * max(NdotL, 0.0) * shadow * sunReach *
                  smoothness * 0.6;

        vec3 viewFresnel = f0 + (1.0 - f0) * pow(1.0 - max(dot(normal, viewDir), 0.0), 5.0);
        vec3 reflectDir = reflect(-viewDir, normal);
        vec3 env = skyLit(reflectDir) * skyTerm;
        colour = mix(colour, env, viewFresnel * smoothness * smoothness * 0.55);
        colour *= 1.0 - metal * 0.35 * smoothness;
    }

    float texLuma = luma(texel.rgb);
    if (material == MAT_LAVA)
        colour = albedo * 4.2 + albedo * light * 0.2;
    else if (material == MAT_FLAME)
        colour += albedo * 3.2 * smoothstep(0.25, 0.75, texLuma);
    else if (material == MAT_PORTAL)
        colour += albedo * 2.8;
    else if (material == MAT_GLOWING)
    {
        float warm = mix(0.5, 1.0, smoothstep(0.0, 0.2, texel.r - texel.b));
        colour += albedo * emission * 3.4 * smoothstep(0.30, 0.85, texLuma) * warm;
    }
    else if (material == MAT_ORE)
    {
        float saturation = max(max(texel.r, texel.g), texel.b) - min(min(texel.r, texel.g), texel.b);
        float mask = smoothstep(0.18, 0.42, saturation) * smoothstep(0.25, 0.65, texLuma);
        colour += albedo * mask * 0.55 * (1.0 - sky * uDaylight * 0.6);
    }
    else if (emission > 0.0)
        colour += albedo * emission * 2.0;

    if (material == MAT_HANGING && emission > 0.0)
        colour += albedo * 2.0 * smoothstep(0.55, 0.85, texLuma);

    float alpha = texel.a;
    if (uPass == 1 && (material == MAT_GLASS || material == MAT_ICE))
    {
        float cosV = max(dot(normal, viewDir), 0.0);
        float fresnel = 0.04 + 0.96 * pow(1.0 - cosV, 5.0);
        vec3 env = skyLit(reflect(-viewDir, normal)) * mix(0.1, 1.0, skyTerm);
        colour = mix(colour, env, fresnel * 0.7);
        alpha = max(alpha, fresnel * 0.6);
    }

    FragColor = vec4(colour, alpha);
}
#version 330 core
#include "common.glsl"

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aUV;
layout (location = 2) in float aShade;
layout (location = 3) in float aSkyLight;
layout (location = 4) in float aBlockLight;
layout (location = 5) in float aFace;
layout (location = 6) in float aTint;

uniform mat4 uView;
uniform mat4 uProjection;
uniform vec3 uChunkOffset;
uniform sampler2D uMaterials;
uniform float uTime;
uniform float uRain;

out vec2 vUV;
out vec3 vTint;
out float vTintSelective;
out float vShade;
out float vSkyLight;
out float vBlockLight;
out vec3 vWorldPos;
out vec3 vViewPos;
flat out int vFace;
flat out int vBlock;
flat out int vMaterial;
flat out vec4 vInfo;

void main()
{
    uint packedTint = uint(max(aTint, 0.0) + 0.5);
    vTint = vec3(float((packedTint >> 14u) & 127u), float((packedTint >> 7u) & 127u), float(packedTint & 127u)) / 64.0;
    vTintSelective = float((packedTint >> 21u) & 1u);
    int face = tagFace(aFace);
    int block = tagBlock(aFace);
    vec4 info = texelFetch(uMaterials, ivec2(block, 0), 0);
    int material = int(info.r * 255.0 + 0.5);

    vec3 world = aPos + uChunkOffset;
    if (block > 0) world += waveOffset(world, material, tagTop(aFace), uTime, uRain);

    vec4 view = uView * vec4(world, 1.0);
    gl_Position = uProjection * view;

    vUV = aUV;
    vShade = aShade;
    vSkyLight = aSkyLight;
    vBlockLight = aBlockLight;
    vWorldPos = world;
    vViewPos = view.xyz;
    vFace = face;
    vBlock = block;
    vMaterial = material;
    vInfo = info;
}
#version 330 core

uniform vec4 uColor;

out vec4 FragColor;

void main()
{
    FragColor = uColor;
}
#version 330 core

layout (location = 0) in vec3 aPos;

uniform mat4 uView;
uniform mat4 uProjection;

void main()
{
    gl_Position = uProjection * uView * vec4(aPos, 1.0);
}
#version 330 core

uniform sampler2D uTexture;

in vec2 vUV;
in float vAlpha;

out vec4 FragColor;

void main()
{
    float a = texture(uTexture, vUV).a * vAlpha;
    if (a < 0.004) discard;
    FragColor = vec4(0.0, 0.0, 0.0, a);
}
#version 330 core

layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 aUV;
layout (location = 2) in float aAlpha;

uniform mat4 uView;
uniform mat4 uProjection;

out vec2 vUV;
out float vAlpha;

void main()
{
    vUV = aUV;
    vAlpha = aAlpha;
    gl_Position = uProjection * uView * vec4(aPos, 1.0);
}
#version 330 core

in vec2 vNdc;

uniform mat4 uInvViewProj;
uniform vec3 uSunDirection;
uniform vec3 uCameraPos;
uniform float uDayFactor; // 0 = midnight, 1 = noon
uniform float uTime;      // seconds, for cloud drift
uniform float uOvercast;  // 0 = clear, 1 = full rain
uniform vec3 uSkyTint;
uniform int uMoonPhase;
uniform int uEnd;
uniform int uHasSun;
uniform int uHasMoon;
uniform int uHasClouds;
uniform sampler2D uSunTex;
uniform sampler2D uMoonTex;
uniform sampler2D uCloudTex;
uniform sampler2D uEndTex;

out vec4 FragColor;

float hash12(vec2 p)
{
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float valueNoise(vec2 p)
{
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);

    float a = hash12(i);
    float b = hash12(i + vec2(1.0, 0.0));
    float c = hash12(i + vec2(0.0, 1.0));
    float d = hash12(i + vec2(1.0, 1.0));

    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float cloudNoise(vec2 p)
{
    float total = 0.0;
    float amplitude = 0.5;
    for (int i = 0; i < 4; ++i)
    {
        total += valueNoise(p) * amplitude;
        p *= 2.1;
        amplitude *= 0.5;
    }
    return total;
}

void main()
{
    // Turn this pixel back into a world-space view ray.
    vec4 farPoint = uInvViewProj * vec4(vNdc, 1.0, 1.0);
    vec3 dir = normalize(farPoint.xyz / farPoint.w);

    if (uEnd == 1)
    {
        vec3 a = abs(dir);
        vec2 face;
        if (a.y >= a.x && a.y >= a.z) face = dir.xz / a.y;
        else if (a.x >= a.z) face = dir.zy / a.x;
        else face = dir.xy / a.z;
        vec3 tile = texture(uEndTex, face * 8.0 + 0.5).rgb;
        FragColor = vec4(tile * (40.0 / 255.0), 1.0);
        return;
    }

    float height = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);

    vec3 tint = dot(uSkyTint, uSkyTint) > 0.0 ? uSkyTint : vec3(1.0);
    vec3 dayZenith = vec3(0.24, 0.48, 0.92) * tint;
    vec3 dayHorizon = vec3(0.70, 0.84, 0.98) * mix(vec3(1.0), tint, 0.5);
    vec3 nightZenith = vec3(0.015, 0.025, 0.08);
    vec3 nightHorizon = vec3(0.06, 0.08, 0.17);

    vec3 zenith = mix(nightZenith, dayZenith, uDayFactor);
    vec3 horizon = mix(nightHorizon, dayHorizon, uDayFactor);

    // Rain takes the blue out of the sky. This is most of what makes
    // weather read as weather: the world dimming on its own just looks
    // like dusk coming early.
    vec3 wetZenith = mix(vec3(0.10, 0.11, 0.13), vec3(0.42, 0.44, 0.48), uDayFactor);
    vec3 wetHorizon = mix(vec3(0.13, 0.14, 0.16), vec3(0.62, 0.64, 0.67), uDayFactor);
    zenith = mix(zenith, wetZenith, uOvercast);
    horizon = mix(horizon, wetHorizon, uOvercast);

    // Warm the horizon while the sun sits near it.
    // No red sunsets through cloud, either.
    float sunset = clamp(1.0 - abs(uSunDirection.y) * 4.0, 0.0, 1.0) * uDayFactor
                 * (1.0 - uOvercast);
    horizon = mix(horizon, vec3(0.96, 0.56, 0.28), sunset * 0.75);

    vec3 color = mix(horizon, zenith, pow(height, 0.6));

    // Stars, fading in as the sun goes down.
    // Cloud hides the stars, the sun and the moon alike.
    float clearSky = 1.0 - uOvercast;
    float nightAmount = clamp(1.0 - uDayFactor * 1.6, 0.0, 1.0) * clearSky;
    if (nightAmount > 0.01 && dir.y > -0.05)
    {
        vec2 starGrid = floor(dir.xz / max(abs(dir.y) + 0.12, 0.12) * 110.0);
        float star = hash12(starGrid);
        float twinkle = 0.75 + 0.25 * sin(uTime * 2.0 + star * 40.0);
        if (star > 0.9965)
            color += vec3(1.0, 0.98, 0.92) * nightAmount * twinkle;
    }

    float sunDot = dot(dir, uSunDirection);
    vec3 sideways = normalize(cross(uSunDirection, vec3(0.0, 0.0, 1.0)));
    vec3 upwards = cross(sideways, uSunDirection);
    if (uHasSun == 1)
    {
        if (sunDot > 0.0)
        {
            vec2 local = vec2(dot(dir, sideways), dot(dir, upwards)) / sunDot / 0.3;
            if (abs(local.x) < 1.0 && abs(local.y) < 1.0)
            {
                vec4 sunTexel = texture(uSunTex, local * 0.5 + 0.5);
                color += sunTexel.rgb * sunTexel.a * clearSky;
            }
        }
    }
    else
    {
        color += vec3(1.0, 0.95, 0.82) * pow(max(sunDot, 0.0), 3000.0) * 12.0 * clearSky;
    }
    color += vec3(1.0, 0.82, 0.55) * pow(max(sunDot, 0.0), 80.0) * 0.22 * uDayFactor * clearSky;

    float moonDot = dot(dir, -uSunDirection);
    if (uHasMoon == 1)
    {
        if (moonDot > 0.0)
        {
            vec2 local = vec2(dot(dir, -sideways), dot(dir, upwards)) / moonDot / 0.2;
            if (abs(local.x) < 1.0 && abs(local.y) < 1.0)
            {
                vec2 cell = vec2(float(uMoonPhase % 4), float(uMoonPhase / 4));
                vec2 moonUv = (cell + local * 0.5 + 0.5) / vec2(4.0, 2.0);
                vec4 moonTexel = texture(uMoonTex, moonUv);
                color += moonTexel.rgb * moonTexel.a * clearSky * (1.0 - uDayFactor * 0.6);
            }
        }
    }
    else
    {
        color += vec3(0.88, 0.90, 1.0) * pow(max(moonDot, 0.0), 4000.0) * 9.0 * nightAmount;
    }

    // A drifting cloud layer, found by intersecting the ray with a plane.
    if (dir.y > 0.015)
    {
        float cloudPlaneY = 164.0;
        float t = (cloudPlaneY - uCameraPos.y) / dir.y;
        if (t > 0.0 && t < 12000.0)
        {
            vec2 cloudPos = (uCameraPos.xz + dir.xz * t) * 0.0016 + vec2(uTime * 0.004, uTime * 0.0015);
            float coverage;
            if (uHasClouds == 1)
            {
                vec2 world = uCameraPos.xz + dir.xz * t + vec2(uTime * 0.6, 0.0);
                float cloud = texture(uCloudTex, world / (12.0 * 256.0)).a;
                coverage = max(step(0.5, cloud), smoothstep(0.3, 0.9, uOvercast) * 0.9);
            }
            else
            {
                float density = cloudNoise(cloudPos);
                coverage = smoothstep(mix(0.52, 0.10, uOvercast),
                                      mix(0.78, 0.30, uOvercast), density);
            }
            // Fade clouds out towards the horizon so the plane edge is hidden.
            coverage *= smoothstep(0.015, 0.22, dir.y);
            vec3 cloudColor = mix(vec3(0.13, 0.14, 0.19), vec3(1.0, 0.99, 0.96), uDayFactor);
            cloudColor = mix(cloudColor, vec3(1.0, 0.76, 0.55), sunset * 0.6);
            cloudColor = mix(cloudColor,
                             mix(vec3(0.09, 0.10, 0.12), vec3(0.40, 0.42, 0.46), uDayFactor),
                             uOvercast);
            color = mix(color, cloudColor, coverage * mix(0.85, 1.0, uOvercast));
        }
    }

    FragColor = vec4(color, 1.0);
}
#version 330 core

layout (location = 0) in vec2 aPos;

out vec2 vNdc;

void main()
{
    vNdc = aPos;
    gl_Position = vec4(aPos, 1.0, 1.0);
}
#version 330 core

in vec2 vUV;
in vec4 vColor;
in vec3 vLight;

uniform sampler2D uTexture;
uniform sampler2D uNormalAtlas;
uniform int uIconNormals;   // 0 when the pack ships no normal maps
uniform int uGlint;
uniform sampler2D uGlintTexture;
uniform vec4 uGlintRect;
uniform vec2 uGlintShift;

out vec4 FragColor;

void main()
{
    vec4 texel = texture(uTexture, vUV);
    if (uGlint == 1)
    {
        if (texel.a < 0.1) discard;
        vec2 local = (gl_FragCoord.xy - uGlintRect.xy) / max(uGlintRect.zw, vec2(1.0));
        mat2 turn = mat2(0.9848, 0.1736, -0.1736, 0.9848);
        vec2 sweep = turn * (local * 0.5) + uGlintShift;
        FragColor = vec4(texture(uGlintTexture, sweep).rgb * 0.8, 1.0);
        return;
    }
    vec4 colour = texel * vColor;

    // A block icon's faces carry the direction the light comes from, in
    // the face's own tangent space. Everything else on the HUD -- every
    // panel, slot and glyph -- passes zero and is drawn flat.
    //
    // This is the same relief the world gets, which is the point: a
    // cobblestone in the hotbar that looks nothing like the cobblestone
    // underfoot reads as two different blocks.
    if (uIconNormals == 1 && dot(vLight, vLight) > 0.0001)
    {
        vec4 normalSample = texture(uNormalAtlas, vUV);

        // LabPBR keeps X and Y; Z is what is left of a unit vector.
        vec2 tangentXY = normalSample.rg * 2.0 - 1.0;
        float tangentZ = sqrt(clamp(1.0 - dot(tangentXY, tangentXY), 0.0, 1.0));
        vec3 normal = normalize(vec3(tangentXY, tangentZ));

        vec3 toLight = normalize(vLight);

        // Wrapped rather than clamped: an icon is small, and a face
        // that went black in its hollows would read as a hole rather
        // than as texture.
        float lit = dot(normal, toLight) * 0.5 + 0.5;
        float level = toLight.z * 0.5 + 0.5;   // what a flat texel would get
        float shape = (lit - level) * 1.35;

        // And the height map's crevices, which owe nothing to where the
        // light is and so survive on the darkest of the three faces.
        float cavity = mix(0.72, 1.0, smoothstep(0.55, 1.0, normalSample.a));

        colour.rgb *= clamp(1.0 + shape, 0.45, 1.75) * cavity;
    }

    FragColor = colour;
    if (FragColor.a < 0.004) discard;
}
#version 330 core

layout (location = 0) in vec2 aPos;
layout (location = 1) in vec2 aUV;
layout (location = 2) in vec4 aColor;
layout (location = 3) in vec3 aLight;

uniform mat4 uProjection;

out vec2 vUV;
out vec4 vColor;
out vec3 vLight;

void main()
{
    gl_Position = uProjection * vec4(aPos, 0.0, 1.0);
    vUV = aUV;
    vColor = aColor;
    vLight = aLight;
}
